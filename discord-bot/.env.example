# Copy this file to .env and fill it in. Nothing here is committed; without a real .env
# the bot refuses to start. If these values were ever public, rotate the bot token in
# the Discord Developer Portal and paste the new one below.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# Application ID from General Information
DISCORD_CLIENT_ID=

# The one server this bot is allowed to run in. It leaves any other guild on connect.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs treated as developer/moderator/support.
DEVELOPER_USER_IDS=

# Optional. Discord invite shown in embeds.
# DISCORD_INVITE_URL=https://discord.gg/your-invite

# Hours a Discord account must exist before the verify button works.
VERIFY_MIN_ACCOUNT_AGE_HOURS=1

# Optional. discordUserId:githubLogin pairs for Contributor seeding, comma-separated.
# GITHUB_LINKS=123456789012345678:YourGitHubLogin

# Optional. Raises GitHub API rate limits for Contributor sync.
# GITHUB_TOKEN=
# GITHUB_REPO=Co2Noss/Lodestar
